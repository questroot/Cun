	check(release_button != null, "actual departure scene exposes boatman action")
	if release_button != null:
		release_button.pressed.emit()
		check(scene.story.flag("released") and scene.modal_open, "departure callback preserves scene")
		check(scene.object_title("ship") == "已离岸的夜船", "departure callback refreshes actual object list immediately")
	scene.close_modal()
	for id in ["xu", "he"]:
		scene.start_game(id)
		for place in ["street", "house", "shelter", "steps"]:
			scene.travel(place)
			await process_frame
			for obj in scene.scene_objects.duplicate():
				scene.nearest = obj.id
				scene.interact()
				await process_frame
				scene.close_modal()
	check(true, "all four scene draw/interaction panels execute for both identities")
	scene.queue_free()
	await process_frame
	print("RESULT checks=", checks, " failures=", failures, " elapsed_ms=", Time.get_ticks_msec() - start)
	quit(0 if failures == 0 else 1)
