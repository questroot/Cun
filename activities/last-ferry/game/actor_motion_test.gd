extends SceneTree
## Headless pure-logic test; no main scene, save, bridge or input.
const Motion = preload("actor_motion.gd")
var failures := 0
var checks := 0
func check(ok: bool, label: String) -> void:
	checks += 1
	if not ok:
		failures += 1
		printerr("FAIL ",label)
func _initialize() -> void:
	var m = Motion.new()
	var o: Dictionary = m.step(0.016,Vector2(450,410),Vector2.DOWN,false,false)
	check(o.reset and o.walk_phase == 0 and o.clip == "idle","initial sync")
	o = m.step(0.016,Vector2(468,410),Vector2.RIGHT,false,false)
	check(is_equal_approx(o.walk_phase,0.25) and o.direction == "E" and o.clip == "walk","distance phase")
	var phase: float = o.walk_phase
	for i in range(10): o = m.step(0.05,Vector2(468,410),Vector2.ZERO,false,false)
	check(o.clip == "idle" and o.walk_phase == phase and o.direction == "E","stopped no sliding or lost face")
	o = m.step(0.01,Vector2(468,410),Vector2.ZERO,false,true,"take")
	check(o.clip == "pickup" and o.segment == "stand" and o.carrying,"authority same frame")
	for i in range(2): o = m.step(0.05,Vector2(468,410),Vector2.ZERO,false,true)
	check(o.segment == "bend","bend keyframe")
	for i in range(2): o = m.step(0.05,Vector2(468,410),Vector2.ZERO,false,true)
	check(o.segment == "contact","contact keyframe")
	for i in range(2): o = m.step(0.05,Vector2(468,410),Vector2.ZERO,false,true)
	check(o.segment == "rise","rise keyframe")
	var frozen := o.duplicate(true)
	o = m.step(99,Vector2(470,410),Vector2.ZERO,true,true,"place")
	check(o == frozen,"freeze no animation or queued event")
	o = m.step(0,Vector2(470,410),Vector2.ZERO,false,true)
	check(o.walk_phase == phase and o.clip == "pickup","resume no movement backlog")
	o = m.step(0,Vector2(470,410),Vector2.ZERO,false,false,"place")
	check(o.clip == "putdown" and o.frame_index == 0 and not o.carrying,"reverse action immediate")
	o = m.step(0.016,Vector2(472,410),Vector2.RIGHT,false,true,"take")
	check(o.clip == "carry_walk" and o.segment.is_empty(),"movement immediately interrupts even same frame")
	o = m.step(0.01,Vector2(472,410),Vector2.ZERO,false,true)
	check(o.clip == "carry_idle","carry stop independent")
	o = m.step(0.05,Vector2(700,500),Vector2.DOWN,false,false)
	check(o.reset and o.walk_phase == 0 and o.clip == "idle","teleport not walking")
	o = m.step(0.05,Vector2(705,500),Vector2.RIGHT,false,false,"","player",true)
	check(o.reset and o.walk_phase == 0,"explicit travel load reset")
	var n = Motion.new()
	n.reset(Vector2(505,430),Vector2.RIGHT,false,"dragging")
	o = n.step(0.02,Vector2(509,430),Vector2.RIGHT,false,false,"","dragging")
	check(o.clip == "drag_walk" and o.foot_offset == Vector2(0,20),"zhou distance drag")
	o = n.step(0.02,Vector2(509,430),Vector2.ZERO,false,false,"","seated")
	check(o.clip == "sit_down" and o.frame_index == 0,"seated transition")
	for i in range(7): o = n.step(0.05,Vector2(509,430),Vector2.ZERO,false,false,"","seated")
	check(o.clip == "seated","sit transition ends")
	o = n.step(0.02,Vector2(509,430),Vector2.ZERO,false,false,"","standing")
	check(o.clip == "stand_up","standing transition")
	o = n.step(0.02,Vector2(513,430),Vector2.RIGHT,false,false,"","dragging")
	check(o.clip == "drag_walk","moving interrupts sit transition")
	var a = Motion.new()
	var b = Motion.new()
	a.reset(Vector2.ZERO); b.reset(Vector2.ZERO)
	var aa: Dictionary = a.step(0.01,Vector2(36,0),Vector2.RIGHT,false,false)
	var bb: Dictionary = b.step(5,Vector2(36,0),Vector2.RIGHT,false,false)
	check(aa.walk_phase == bb.walk_phase and aa.frame_index == bb.frame_index,"walk independent of time")
	print("ACTOR_MOTION_CHECKS=",checks," FAILURES=",failures)
	quit(0 if failures == 0 else 1)
